{
  "name": "projects-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "VERO"
  ],
  "scripts": {
    "dev": "tsx VERO/server.ts",
    "build": "npm run build:vero && npm run build:server",
    "build:vero": "npm run build --workspace=vero",
    "build:server": "esbuild VERO/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "npm run lint --workspace=vero",
    "guardian:links": "tsx scripts/guardian/check-links.ts",
    "guardian:repo": "tsx scripts/guardian/check-code-repo.ts",
    "guardian:check": "npm run guardian:links && npm run guardian:repo"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0"
  }
}
