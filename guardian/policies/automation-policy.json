{
  "autoFix": {
    "enabled": true,
    "allowedRiskLevels": ["low"],
    "requiresValidation": true,
    "requiresPullRequest": true,
    "autoMerge": false,
    "minimumConfidence": 0.8,
    "maximumFilesChanged": 3,
    "maximumLinesChanged": 50
  },
  "protectedPaths": [
    ".github/workflows/",
    ".env",
    ".env.",
    "vercel.json",
    "package.json",
    "package-lock.json",
    "bun.lock",
    "yarn.lock",
    "pnpm-lock.yaml",
    "server.ts",
    "VERO/server.ts",
    "authentication/",
    "security/",
    "secrets/",
    "credentials/",
    "deployment/",
    "infrastructure/",
    "README.md"
  ]
}
